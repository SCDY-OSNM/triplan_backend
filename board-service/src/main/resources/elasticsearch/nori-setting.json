{
  "analysis": {
    "analyzer": {
      "nori_analyzer": {
        "type": "custom",
        "tokenizer": "nori_tokenizer",
        "filter": ["nori_readingform", "lowercase"]
      },
      "nori_search_analyzer": {
        "type": "custom",
        "tokenizer": "nori_tokenizer",
        "filter": ["nori_part_of_speech", "lowercase"]
      }
    },
    "tokenizer": {
      "nori_tokenizer": {
        "type": "nori_tokenizer",
        "decompound_mode": "mixed"
      }
    },
    "filter": {
      "nori_readingform": {
        "type": "nori_readingform"
      },
      "nori_part_of_speech": {
        "type": "nori_part_of_speech",
        "stoptags": ["E", "EC", "EP", "EF",
          "VV", "VA", "VX", "VCP", "VCN",
          "XSA", "XSN", "XSV",
          "J", "IC", "MM", "MAG", "MAJ",
          "SP", "SSC", "SSO", "SC", "SE", "UNA", "VSV"]
      }
    }
  }
}